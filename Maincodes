CREATE TABLE approval_flow_config (
    config_id      BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    travel_type    VARCHAR(20)
        CHECK (travel_type IN ('DOMESTIC','INTERNATIONAL')),

    level_no       INT NOT NULL,               -- 1,2,3,4...
    approver_role  VARCHAR(50) NOT NULL,        -- MANAGER, FINANCE, HR, etc.

    is_mandatory   BOOLEAN DEFAULT TRUE
);
