
CREATE TABLE travel_requests (
    travel_request_id   BIGINT
        GENERATED ALWAYS AS IDENTITY
        (START WITH 1 INCREMENT BY 1)
        PRIMARY KEY,

    employee_id         VARCHAR(20) NOT NULL,
    employee_name       VARCHAR(100),
    department          VARCHAR(50),
    grade               VARCHAR(20),

    travel_type         VARCHAR(20)
        CHECK (travel_type IN ('DOMESTIC', 'INTERNATIONAL')),

    purpose_of_travel   VARCHAR(255),
    start_date          DATE,
    end_date            DATE,
    from_location       VARCHAR(50),
    to_location         VARCHAR(50),
    destination_country VARCHAR(50),
    travel_mode         VARCHAR(20),
    class_of_travel     VARCHAR(20),

    estimated_total_cost DECIMAL(12,2),
    currency             VARCHAR(10),

    request_status      VARCHAR(20)
        CHECK (request_status IN
        ('DRAFT','SUBMITTED','IN_APPROVAL','APPROVED','REJECTED'))
        DEFAULT 'DRAFT',

    created_at          TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    submitted_at        TIMESTAMP
);
